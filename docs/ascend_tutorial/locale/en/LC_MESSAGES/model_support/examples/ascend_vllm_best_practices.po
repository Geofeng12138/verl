"          batch_size=48, # 推理的最大并发数\n"
"          trust_remote_code=False,\n"
"          generation_kwargs = dict(\n"
"              temperature = 0.5,\n"
"              top_k = 10,\n"
"              top_p = 0.95,\n"
"              seed = None,\n"
"              repetition_penalty = 1.03,\n"
"          )\n"
"      )\n"
"  ]\n"
""
