msgid ""
"  models = [\n"
"      dict(\n"
"          attr=\"service\",\n"
"          type=VLLMCustomAPI,\n"
"          abbr='vllm-api-general',\n"
"          path=\"/path/to/Qwen3-30B\", # 修改为 Qwen3-30B 模型路径\n"
"          model=\"qwen3-30b\",\n"
"          request_rate = 0,\n"
"          retry = 2,\n"
"          host_ip = \"localhost\", # 推理服务的IP\n"
"          host_port = 6380,\n"
"          max_seq_len = 2048, # 最大输入tokens长度\n"
