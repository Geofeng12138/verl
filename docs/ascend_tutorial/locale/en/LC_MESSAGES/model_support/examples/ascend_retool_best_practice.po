msgid ""
"  # 创建日志文件\n"
"  export TIMESTAMP=$(date +%Y%m%d_%H%M%S)\n"
"  LOG_DIR=\"$HDFS_ROOT/verl/logs/$project_name/$experiment_name\"\n"
"  # 判断路径是否存在\n"
"  if [ ! -d \"$LOG_DIR\" ]; then\n"
"    # 路径不存在，创建路径\n"
"    mkdir -p \"$LOG_DIR\"\n"
"    echo \"Directory $LOG_DIR created.\"\n"
"  else\n"
"    echo \"Directory $LOG_DIR already exists.\"\n"
"  fi\n"
""
