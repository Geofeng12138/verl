"               ranks: [0]  # 全局 GPU rank；会被映射到拥有该 rank 的推理实例（replica）\n"
"               tool_config:\n"
"                  npu:\n"
"                     discrete: True  # Agent Loop 模式下必须开启离散模式\n"
