msgid ""
"      global_profiler:\n"
"         steps: [1, 2, 5]\n"
"         save_path: ./outputs/profile\n"
"      actor_rollout_ref:\n"
"         actor:\n"
"            profiler:\n"
"               enable: True  # 设置为 True 以采集训练阶段\n"
"               all_ranks: False\n"
"               ranks: [0]  # 全局 Rank 0\n"
"               tool_config:\n"
"                  npu:\n"
"                     discrete: True\n"
"                     contents: [npu, cpu]\n"
"         rollout:\n"
"            profiler:\n"
"               enable: True  # 设置为 True 以采集推理阶段\n"
